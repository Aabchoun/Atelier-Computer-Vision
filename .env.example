# Template for your personal .env file (copy it to .env, then fill in your own values).
# .env is ignored by Git: never commit it, never paste keys in chats, code or notebooks.
# Write values without quotes or spaces, and nothing after the value on the same line.

# NASA FIRMS MAP_KEY (received by email from https://firms.modaps.eosdis.nasa.gov/api/map_key/)
FIRMS_MAP_KEY=

# Google Cloud project ID registered for Earth Engine (non-commercial), e.g. ee-yourname
GEE_PROJECT=
